# ============================================================
# Rotulate Publicidad - Security & Performance Headers
# Hostinger (LiteSpeed) compatible
# ============================================================

# --- Security Headers ---
<IfModule mod_headers.c>
    # Content Security Policy (refuerza la meta tag del HTML)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.gstatic.com https://apis.google.com https://cdn.jsdelivr.net; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://ucarecdn.com https://www.google-analytics.com https://www.googletagmanager.com https://wtljdvexsksextnhpkkd.supabase.co; connect-src 'self' https://api.emailjs.com https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://www.gstatic.com https://wtljdvexsksextnhpkkd.supabase.co; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; worker-src blob:; upgrade-insecure-requests"

    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header set X-Frame-Options "DENY"

    # XSS Protection (legacy browsers)
    Header set X-XSS-Protection "1; mode=block"

    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy - restrict browser features
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Strict Transport Security (HTTPS only)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Prevent information leakage
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# --- Force HTTPS & Consolidate SEO (Non-WWW & Clean Index) ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Redirigir WWW a Non-WWW (Consolida autoridad SEO)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # 2. Redirigir index.html de la raíz a la raíz del sitio
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
    RewriteRule ^index\.html$ https://rotulatepublicidad.com/ [R=301,L]

    # 3. Redirigir index.html de subcarpetas a su respectiva ruta limpia (ej: /lonas-cancun/)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*index\.html\ HTTP/
    RewriteRule ^(([^/]+/)*)index\.html$ https://rotulatepublicidad.com/$1 [R=301,L]

    # 4. Forzar HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 5. Redirigir URLs heredadas de WordPress/Elementor antiguas a la raíz limpia
    RewriteRule ^home-b2/?$ https://rotulatepublicidad.com/ [R=301,L]

    # 6. Redirigir peticiones con parámetros de Elementor limpiando la URL
    RewriteCond %{QUERY_STRING} ^elementor_library= [NC]
    RewriteRule ^$ https://rotulatepublicidad.com/? [R=301,L]

    # 7. Forzar barra diagonal al final de /lonas-cancun (evita "Error de redirección")
    RewriteRule ^lonas-cancun$ https://rotulatepublicidad.com/lonas-cancun/ [R=301,L]

    # 8. Declarar URL antigua /sectores/ como eliminada permanentemente (410 Gone) para que Google la borre de su índice
    RewriteRule ^sectores/?$ - [G,L]
</IfModule>

# --- Cache Control ---
<IfModule mod_expires.c>
    ExpiresActive On

    # Images: 1 year (los assets cambian de nombre al actualizarse: -thumb, ?v=)
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    # Fonts: 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

    # CSS/JS: 1 week
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"

    # HTML: no cache (always fresh)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Block access to sensitive files ---
<FilesMatch "\.(htaccess|htpasswd|env|git|gitignore|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# --- Prevent directory listing ---
Options -Indexes

# --- Custom error pages (optional, prevents info leaks) ---
ErrorDocument 404 /404.html
