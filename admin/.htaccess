# Admin panel — seguridad y sin caché
<IfModule mod_headers.c>
    # Sin caché en páginas admin
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"

    # CSP específico del admin (permite Quill.js CDN)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.quilljs.com; style-src 'self' https://cdn.quilljs.com 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# Bloquear acceso directo a config.php
<Files "config.php">
    Require all denied
</Files>

# Sin listado de directorio
Options -Indexes
